# Keep project source and build inputs; exclude local experiments and generated files.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/README.en.md
!/README.ja.md
!/README.es.md
!/LICENSE
!/NOTICE
!/docs/
!/CHANGELOG.md
!/build.ps1
!/global.json
!/LumaRecode.slnx
!/LumaRecode.sln
!/Directory.Build.props
!/Packaging/
!/pyproject.toml
!/tools/
!/licenses/
!/App/
!/Bundle/
!/Core/
!/Assets/
!/Brand/
!/qa/
/App/app.ico
/qa/*
!/qa/README.md
!/qa/LanguageChecks/
!/qa/RuntimeChecks/
!/qa/CliChecks/
!/qa/MemoryChecks/
!/qa/SerializationChecks/
!/qa/FormatChecks/
!/qa/BackendChecks/
!/qa/PerformanceChecks/
!/qa/TimingChecks/
!/qa/HdrChecks/
!/qa/FrameChecks/
!/qa/DocumentationChecks/
!/qa/BuildChecks/
**/bin/
**/obj/
**/__pycache__/
*.py[cod]
*.user
*.suo
.vs/
