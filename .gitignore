# Keep project source and build inputs; exclude local experiments and generated files.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/ACCESSIBILITY.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
!/LICENSE
!/NOTICE
!/docs/
!/site/
!/CHANGELOG.md
!/build.ps1
!/global.json
!/LumaRecode.slnx
!/LumaRecode.sln
!/Directory.Build.props
!/Packaging/
!/pyproject.toml
!/tools/
!/licenses/
!/App/
!/Bundle/
!/Core/
!/Assets/
!/Brand/
!/qa/
!/engine/
!/macOS/
!/Interop/
!/CMakeLists.txt
!/CMakePresets.json
!/rust-toolchain.toml
!/.clang-format
!/.github/
!/.config/
/.config/*
!/.config/dotnet-tools.json
/App/app.ico
/qa/*
!/qa/README.md
!/qa/LanguageChecks/
!/qa/RuntimeChecks/
!/qa/CliChecks/
!/qa/MemoryChecks/
!/qa/SerializationChecks/
!/qa/FormatChecks/
!/qa/BackendChecks/
!/qa/PerformanceChecks/
!/qa/TimingChecks/
!/qa/HdrChecks/
!/qa/FrameChecks/
!/qa/DocumentationChecks/
!/qa/BuildChecks/
!/qa/NativeCoreChecks/
**/bin/
**/obj/
**/__pycache__/
**/xcuserdata/
*.xcuserstate
.DS_Store
*.py[cod]
*.user
*.suo
.vs/
**/target/
/out/
CMakeUserPresets.json
