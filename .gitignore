# Keep project source and build inputs; exclude local experiments and generated files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/NOTICE
!/docs/
!/HISTORY.md
!/CHANGELOG.md
!/build.ps1
!/global.json
!/tools/
!/licenses/
!/App/
!/Bundle/
!/Worker/
!/Brand/
!/qa/
/App/app.ico
/qa/*
!/qa/LanguageChecks/
!/qa/RuntimeChecks/
!/qa/CliChecks/
!/qa/MemoryChecks/
!/qa/SerializationChecks/
**/bin/
**/obj/
**/__pycache__/
*.py[cod]
*.user
*.suo
.vs/
