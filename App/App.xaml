<Application x:Class="VideoConverter.ConverterApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="FrameFlowUIFontFamily">ms-appx:///Assets/Fonts/SourceSans3VF-Upright.ttf#SourceSans3VF, ms-appx:///Assets/Fonts/SourceHanSansCN-VF.ttf#Source Han Sans CN VF, ms-appx:///Assets/Fonts/SourceHanSansJP-VF.ttf#Source Han Sans JP VF, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource FrameFlowUIFontFamily}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
