<Application x:Class="VideoConverter.ConverterApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="FrameFlowUIFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, Yu Gothic UI, Meiryo, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource FrameFlowUIFontFamily}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
