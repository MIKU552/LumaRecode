{
  "archive": {
    "avc": {
      "encoder": "libx264",
      "preset": "medium",
      "quality": 21,
      "pixel_format": "yuv420p",
      "encoder_parameters": {
        "aq-mode": 2,
        "aq-strength": 0.8
      }
    },
    "hevc": {
      "encoder": "libx265",
      "preset": "medium",
      "quality": 23,
      "pixel_format": "yuv420p10le",
      "encoder_parameters": {
        "rdoq-level": 2,
        "psy-rdoq": 1
      }
    },
    "av1": {
      "encoder": "libsvtav1",
      "preset": "4",
      "quality": 32,
      "pixel_format": "yuv420p10le",
      "tune": 0,
      "lp": 0,
      "encoder_parameters": {
        "enable-qm": 1,
        "qm-min": 8,
        "qm-max": 15
      }
    }
  },
  "archive_fast_av1": {
    "encoder": "libsvtav1",
    "preset": "6",
    "quality": 32,
    "pixel_format": "yuv420p10le",
    "tune": 0,
    "lp": 4,
    "encoder_parameters": {
      "enable-qm": 1,
      "qm-min": 8,
      "qm-max": 15,
      "hierarchical-levels": 4
    }
  },
  "share": {
    "avc": {
      "encoder": "h264_qsv",
      "preset": "4",
      "quality": 22,
      "async_depth": 4
    },
    "hevc": {
      "encoder": "hevc_qsv",
      "preset": "4",
      "quality": 24,
      "async_depth": 4
    },
    "av1": {
      "encoder": "av1_qsv",
      "preset": "4",
      "quality": 26,
      "async_depth": 4
    }
  },
  "hardware": {
    "nvenc": {
      "label": "NVIDIA NVENC",
      "codecs": {
        "avc": {
          "encoder": "h264_nvenc",
          "arguments": {
            "8": ["-preset", "p4", "-tune", "hq", "-rc", "vbr", "-cq", "25", "-b:v", "0"]
          }
        },
        "hevc": {
          "encoder": "hevc_nvenc",
          "arguments": {
            "8": ["-preset", "p4", "-tune", "hq", "-rc", "vbr", "-cq", "27", "-b:v", "0"],
            "10": ["-preset", "p4", "-tune", "hq", "-rc", "vbr", "-cq", "27", "-b:v", "0"]
          }
        },
        "av1": {
          "encoder": "av1_nvenc",
          "arguments": {
            "8": ["-preset", "p4", "-tune", "hq", "-rc", "vbr", "-cq", "34", "-b:v", "0"],
            "10": ["-preset", "p4", "-tune", "hq", "-rc", "vbr", "-cq", "34", "-b:v", "0"]
          }
        }
      }
    },
    "amf": {
      "label": "AMD AMF",
      "codecs": {
        "avc": {
          "encoder": "h264_amf",
          "arguments": {
            "8": ["-usage", "transcoding", "-quality", "balanced", "-rc", "qvbr", "-qvbr_quality_level", "30"]
          }
        },
        "hevc": {
          "encoder": "hevc_amf",
          "arguments": {
            "8": ["-usage", "transcoding", "-quality", "balanced", "-rc", "qvbr", "-qvbr_quality_level", "30"],
            "10": ["-usage", "transcoding", "-quality", "balanced", "-rc", "cqp", "-qp_i", "24", "-qp_p", "24", "-bitdepth", "10", "-preanalysis", "0"]
          }
        },
        "av1": {
          "encoder": "av1_amf",
          "arguments": {
            "8": ["-usage", "transcoding", "-quality", "balanced", "-rc", "qvbr", "-qvbr_quality_level", "26"],
            "10": ["-usage", "transcoding", "-quality", "balanced", "-rc", "cqp", "-qp_i", "26", "-qp_p", "26", "-bitdepth", "10", "-preanalysis", "0"]
          }
        }
      }
    },
    "videotoolbox": {
      "label": "Apple VideoToolbox",
      "platform": "macos",
      "codecs": {
        "avc": {
          "encoder": "h264_videotoolbox",
          "arguments": {
            "8": ["-allow_sw", "0", "-q:v", "70"]
          }
        },
        "hevc": {
          "encoder": "hevc_videotoolbox",
          "arguments": {
            "8": ["-allow_sw", "0", "-q:v", "65"],
            "10": ["-allow_sw", "0", "-q:v", "68"]
          }
        }
      }
    },
    "mf": {
      "label": "Media Foundation",
      "codecs": {
        "avc": {
          "encoder": "h264_mf",
          "arguments": {
            "8": ["-hw_encoding", "1", "-rate_control", "quality", "-quality", "75"]
          }
        },
        "hevc": {
          "encoder": "hevc_mf",
          "arguments": {
            "8": ["-hw_encoding", "1", "-rate_control", "quality", "-quality", "75"]
          }
        }
      }
    }
  },
  "audio": {
    "archive_default": "copy",
    "share_default": {
      "avc": "aac",
      "hevc": "aac",
      "av1": "opus"
    },
    "aac": {
      "encoder": "aac",
      "bitrate_kbps": 256,
      "channels": 2,
      "sample_rate": "source"
    },
    "opus": {
      "encoder": "libopus",
      "bitrate_kbps": 192,
      "channels": 2,
      "sample_rate": 48000,
      "vbr": "on",
      "application": "audio",
      "compression_level": 10
    },
    "av1_compatibility_audio": "aac",
    "note": "有损预设为双声道；AV1默认Opus192K，另保留AAC256K兼容项。归档默认复制全部原音轨。音频不与视频编码器技术绑定。"
  }
}
