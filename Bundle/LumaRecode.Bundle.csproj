<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>../App/app.manifest</ApplicationManifest>
    <ApplicationIcon>../App/LumaRecode.ico</ApplicationIcon>
    <AssemblyName>LumaRecode</AssemblyName>
    <Product>映码 · LumaRecode</Product>
    <Title>映码 · LumaRecode</Title>
    <Version>4.3.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../App/StartupMode.cs" Link="StartupMode.cs" />
    <Compile Include="../App/ConsoleConnection.cs" Link="ConsoleConnection.cs" />
    <Compile Include="../App/CliError.cs" Link="CliError.cs" />
    <Content Include="../dist/NativeAot/**/*" Exclude="../dist/NativeAot/**/*.pdb"
             Link="Application/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- IDE and formatting workspaces can load a fresh checkout before publishing. -->
  <Target Name="RequireNativePayload" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('../dist/NativeAot/LumaRecode.exe')" Text="Build the Native AOT application before bundling. Use build.ps1." />
  </Target>
</Project>
