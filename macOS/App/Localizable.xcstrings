    "Dolby Vision 8.4 requires standard HLG, HEVC and MP4.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision 8.4 需要普通 HLG 素材，并使用 HEVC 和 MP4。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision 8.4 には標準 HLG 素材、HEVC、MP4 が必要です。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision 8.4 requiere material HLG estándar, HEVC y MP4."
          }
        }
