            "value": "Codificando vídeo…"
          }
        }
      }
    },
    "Enter a valid first and last frame.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的起始帧和结束帧。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始フレームと終了フレームを確認してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un fotograma inicial y final válidos."
          }
        }
      }
    },
