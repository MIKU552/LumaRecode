    "Leave the paths blank to use the tools found in PATH or Homebrew.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空时自动从 PATH 或 Homebrew 查找工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合は PATH または Homebrew のツールを使用します。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja las rutas vacías para usar las herramientas de PATH o Homebrew."
