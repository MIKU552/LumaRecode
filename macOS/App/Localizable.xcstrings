          "stringUnit": {
            "state": "translated",
            "value": "Convertir a HDR estándar"
          }
        }
      }
    },
    "Drop a video here or select one to begin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入视频，或选择要转换的文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画をドラッグするか、ファイルを選択してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un vídeo aquí o selecciona un archivo."
          }
        }
      }
    },
    "Encoding": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编码"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
