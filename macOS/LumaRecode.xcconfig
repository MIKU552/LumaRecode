SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
ARCHS = arm64
SWIFT_VERSION = 6.0
CLANG_ENABLE_MODULES = YES
SWIFT_INCLUDE_PATHS = "$(SRCROOT)/../engine/include"
LIBRARY_SEARCH_PATHS = "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)"
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks
OTHER_LDFLAGS = -lLumaRecodeCore
ENABLE_USER_SCRIPT_SANDBOXING = NO
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
ENABLE_HARDENED_RUNTIME = NO
PRODUCT_NAME = LumaRecode
PRODUCT_BUNDLE_IDENTIFIER = io.github.miku552.lumarecode
MARKETING_VERSION = 5.0.1
CURRENT_PROJECT_VERSION = 50010
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = App/DistributionInfo.plist
LUMARECODE_DISPLAY_VERSION = 5.0.1
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.video
SWIFT_EMIT_LOC_STRINGS = YES
